---
import Layout from "../layouts/Layout.astro";
import Queue from "../components/Queue.tsx";
import { items } from "@wix/data";

type QueueState = {
	_id?: string;
	title?: string;
	currentHead?: number;
	lastIssued?: number;
	totalDepartures?: number;
	startingDepth?: number;
	updatedAt?: string;
};

let initialState: QueueState = {
	currentHead: 1,
	lastIssued: 3179,
	totalDepartures: 0,
	startingDepth: 3179,
};

try {
	const result = await items.query("queue-state").limit(1).find();
	if (result.items[0]) {
		initialState = result.items[0] as QueueState;
	}
} catch (error) {
	console.error("Unable to load queue state", error);
}
---

<Layout>
	<Queue client:only="react" initialState={initialState} />
</Layout>

<style is:global>
	/* ---------- shared kickers ---------- */
	.join-kicker,
	.join-label,
	.join-note,
	.pos-label,
	.pos-sub,
	.metric-label,
	.track-head span,
	.track-note,
	.wq-fine,
	.removed-kicker,
	.removed-note,
	.turn-kicker,
	.presence {
		text-transform: uppercase;
	}

	/* ============ JOINING ============ */
	.phase-joining {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 40px;
		text-align: center;
	}

	.join-kicker {
		font-size: 11px;
		letter-spacing: 0.4em;
		color: #7c828c;
		margin-bottom: 40px;
	}

	.join-label {
		font-size: 12px;
		letter-spacing: 0.3em;
		color: #7c828c;
		margin-bottom: 24px;
		animation: joinflick 1.2s ease-in-out infinite;
	}

	.join-display {
		font-size: clamp(56px, 16vw, 160px);
		font-weight: 300;
		line-height: 1;
		letter-spacing: 0.02em;
		font-variant-numeric: tabular-nums;
		color: #e6e8ea;
	}

	.join-bar {
		margin-top: 48px;
		height: 1px;
		width: min(360px, 70vw);
		background: #1e2228;
		position: relative;
		overflow: hidden;
	}

	.join-bar-fill {
		position: absolute;
		inset: 0 auto 0 0;
		width: 40%;
		background: #d8a63f;
		animation: joinslide 1.6s ease-in-out infinite;
	}

	.join-note {
		margin-top: 24px;
		font-size: 11px;
		letter-spacing: 0.25em;
		color: #4a4f57;
	}

	/* ============ WAITING ============ */
	.phase-waiting {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	.wq-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 16px;
		padding: 18px clamp(16px, 4vw, 48px);
		border-bottom: 1px solid #1e2228;
		flex-wrap: wrap;
	}

	.wq-brand {
		font-size: 12px;
		letter-spacing: 0.42em;
		text-transform: uppercase;
		color: #e6e8ea;
		font-weight: 500;
	}

	.wq-terminal {
		font-size: 10.5px;
		letter-spacing: 0.28em;
		text-transform: uppercase;
		color: #7c828c;
		font-variant-numeric: tabular-nums;
	}

	.grace-banner {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 14px;
		padding: 12px 20px;
		background: rgba(214, 83, 63, 0.09);
		border-bottom: 1px solid rgba(214, 83, 63, 0.4);
		text-align: center;
	}

	.grace-banner[hidden] {
		display: none;
	}

	.grace-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: #d6533f;
		animation: gracepulse 1s ease-in-out infinite;
		flex-shrink: 0;
	}

	.grace-banner span:last-child {
		font-size: 11px;
		letter-spacing: 0.24em;
		text-transform: uppercase;
		color: #d6533f;
		font-variant-numeric: tabular-nums;
	}

	.wq-center {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: clamp(32px, 7vh, 80px) clamp(16px, 4vw, 48px);
		text-align: center;
	}

	.presence-row {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-bottom: clamp(16px, 3vh, 32px);
		min-height: 12px;
	}

	.presence {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-size: 10.5px;
		letter-spacing: 0.28em;
		color: #7c828c;
	}

	.presence[hidden] {
		display: none;
	}

	.presence .pdot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #6c8a5a;
	}

	.presence.unfocused {
		color: #d6533f;
	}

	.presence.unfocused .pdot {
		background: #d6533f;
		animation: gracepulse 1s ease-in-out infinite;
	}

	.pos-label {
		font-size: 11px;
		letter-spacing: 0.36em;
		text-transform: uppercase;
		color: #7c828c;
		margin-bottom: clamp(12px, 2.5vh, 28px);
	}

	.pos-number {
		display: flex;
		align-items: flex-end;
		justify-content: center;
		gap: 0.14em;
		line-height: 0.9;
		padding-bottom: 0.04em;
	}

	.pos-number > span:first-child {
		font-size: clamp(84px, 24vw, 340px);
		font-weight: 300;
		letter-spacing: -0.01em;
		font-variant-numeric: tabular-nums;
		color: #f2f0ea;
	}

	.caret {
		width: clamp(14px, 3.4vw, 44px);
		height: clamp(30px, 7vw, 96px);
		background: #d8a63f;
		animation: caretblink 1.1s step-end infinite;
		margin-bottom: clamp(8px, 2vw, 26px);
		flex-shrink: 0;
	}

	.pos-sub {
		margin-top: clamp(24px, 4vh, 44px);
		font-size: 12px;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: #7c828c;
	}

	.wq-lower {
		border-top: 1px solid #1e2228;
		padding: clamp(20px, 4vw, 40px) clamp(16px, 4vw, 48px);
		display: flex;
		flex-direction: column;
		gap: clamp(24px, 4vh, 36px);
		max-width: 1180px;
		width: 100%;
		margin: 0 auto;
	}

	.metrics {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
		gap: 1px;
		background: #1e2228;
		border: 1px solid #1e2228;
	}

	.metric {
		background: #0a0b0d;
		padding: 18px 20px;
	}

	.metric-label {
		font-size: 10px;
		letter-spacing: 0.26em;
		text-transform: uppercase;
		color: #7c828c;
		margin-bottom: 10px;
	}

	.metric-value {
		font-size: 26px;
		font-weight: 400;
		font-variant-numeric: tabular-nums;
		color: #e6e8ea;
	}

	.track-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		margin-bottom: 10px;
	}

	.track-head span {
		font-size: 10px;
		letter-spacing: 0.26em;
		text-transform: uppercase;
		color: #7c828c;
	}

	.track {
		position: relative;
		height: 76px;
		border: 1px solid #2a2f37;
		background: #101216;
		overflow: hidden;
	}

	.track-grid {
		position: absolute;
		inset: 0;
		background-image: repeating-linear-gradient(90deg, #2a2f37 0 1px, transparent 1px 9px);
		opacity: 0.45;
	}

	.track-fill {
		position: absolute;
		top: 0;
		bottom: 0;
		left: 0;
		background: linear-gradient(90deg, rgba(255, 255, 255, 0.015), rgba(255, 255, 255, 0.05));
		border-right: 1px solid #d8a63f;
	}

	.track-marker {
		position: absolute;
		top: 0;
		bottom: 0;
		width: 2px;
		background: #d8a63f;
		transform: translateX(-1px);
		box-shadow: 0 0 10px #d8a63f;
	}

	.track-you {
		position: absolute;
		top: 9px;
		transform: translateX(-50%);
		font-size: 9.5px;
		letter-spacing: 0.18em;
		color: #d8a63f;
		white-space: nowrap;
		font-weight: 600;
	}

	.track-ticket {
		position: absolute;
		bottom: 9px;
		transform: translateX(-50%);
		font-size: 9.5px;
		letter-spacing: 0.06em;
		color: #7c828c;
		white-space: nowrap;
	}

	.track-note {
		margin-top: 10px;
		font-size: 10.5px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #4a4f57;
	}

	.pass-module {
		border: 1px solid #2a2f37;
		display: flex;
		flex-wrap: wrap;
		align-items: stretch;
	}

	.pass-copy-cell {
		flex: 1 1 260px;
		padding: 20px 22px;
		border-right: 1px solid #2a2f37;
	}

	.pass-title {
		font-size: 11px;
		letter-spacing: 0.24em;
		text-transform: uppercase;
		color: #e6e8ea;
		margin-bottom: 10px;
	}

	.pass-copy {
		font-size: 12.5px;
		line-height: 1.6;
		color: #7c828c;
		font-family: "IBM Plex Sans", sans-serif;
		letter-spacing: 0.01em;
		max-width: 520px;
	}

	.pass-status {
		min-height: 1.4em;
		margin-top: 12px;
		font-size: 11px;
		letter-spacing: 0.04em;
		color: #6c8a5a;
		font-family: "IBM Plex Sans", sans-serif;
	}

	.pass-action-cell {
		flex: 0 0 auto;
		padding: 20px 22px;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: flex-start;
		gap: 12px;
		min-width: 180px;
	}

	.pass-price {
		font-size: 30px;
		font-weight: 400;
		font-variant-numeric: tabular-nums;
		color: #e6e8ea;
	}

	.pass-button {
		font-family: "IBM Plex Mono", monospace;
		font-size: 10.5px;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: #0a0b0d;
		background: #d8a63f;
		border: none;
		padding: 12px 20px;
		cursor: pointer;
		transition: background 160ms ease;
	}

	.pass-button:hover:not(:disabled) {
		background: #e8bd63;
	}

	.pass-button:disabled {
		cursor: not-allowed;
		opacity: 0.5;
	}

	.wq-fine {
		font-size: 10px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: #383c43;
		text-align: center;
		line-height: 2;
	}

	.grace-vignette {
		position: fixed;
		inset: 0;
		pointer-events: none;
		box-shadow: inset 0 0 220px 40px rgba(214, 83, 63, 0.28);
		animation: vignettepulse 2.2s ease-in-out infinite;
		z-index: 5;
	}

	.grace-vignette[hidden] {
		display: none;
	}

	/* ============ REMOVED ============ */
	.phase-removed {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 40px;
		text-align: center;
	}

	.removed-kicker {
		font-size: 11px;
		letter-spacing: 0.32em;
		text-transform: uppercase;
		color: #d6533f;
		margin-bottom: 40px;
	}

	.removed-title {
		font-size: clamp(28px, 6vw, 58px);
		font-weight: 300;
		letter-spacing: 0.01em;
		line-height: 1.15;
		color: #e6e8ea;
		max-width: 14ch;
	}

	.removed-copy {
		margin-top: 32px;
		font-size: 13px;
		letter-spacing: 0.1em;
		color: #7c828c;
		font-family: "IBM Plex Sans", sans-serif;
		max-width: 44ch;
		line-height: 1.7;
	}

	.removed-note {
		margin-top: 56px;
		font-size: 10.5px;
		letter-spacing: 0.26em;
		text-transform: uppercase;
		color: #4a4f57;
	}

	/* ============ TURN ============ */
	.phase-turn {
		position: fixed;
		inset: 0;
		z-index: 30;
		background: #f2f0ea;
		color: #0a0b0d;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: clamp(24px, 5vw, 64px);
		text-align: center;
	}

	.turn-kicker {
		font-size: 11px;
		letter-spacing: 0.4em;
		text-transform: uppercase;
		color: #6b675c;
		margin-bottom: clamp(24px, 5vh, 56px);
	}

	.turn-title {
		font-size: clamp(40px, 8vw, 132px);
		font-weight: 500;
		line-height: 0.98;
		letter-spacing: -0.02em;
		max-width: 15ch;
		text-wrap: balance;
	}

	.turn-note {
		margin-top: clamp(32px, 6vh, 64px);
		font-size: clamp(12px, 1.6vw, 15px);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #6b675c;
	}

	/* ============ PASS RECEIPT OVERLAY ============ */
	.pass-overlay {
		position: fixed;
		inset: 0;
		z-index: 20;
		background: rgba(10, 11, 13, 0.86);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 24px;
	}

	.pass-overlay[hidden] {
		display: none;
	}

	.receipt {
		width: min(420px, 100%);
		border: 1px solid #2a2f37;
		background: #101216;
	}

	.receipt-head {
		padding: 22px 24px;
		border-bottom: 1px dashed #2a2f37;
		display: flex;
		justify-content: space-between;
		align-items: baseline;
	}

	.receipt-title {
		font-size: 11px;
		letter-spacing: 0.24em;
		text-transform: uppercase;
		color: #e6e8ea;
	}

	.receipt-status {
		font-size: 10px;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: #6c8a5a;
	}

	.receipt-body {
		padding: 24px;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.receipt-row {
		display: flex;
		justify-content: space-between;
		font-size: 12px;
		letter-spacing: 0.06em;
		color: #7c828c;
	}

	.receipt-row .rv {
		color: #e6e8ea;
		font-variant-numeric: tabular-nums;
	}

	.receipt-note {
		border-top: 1px dashed #2a2f37;
		padding-top: 16px;
		font-size: 11px;
		line-height: 1.7;
		color: #4a4f57;
		letter-spacing: 0.04em;
		font-family: "IBM Plex Sans", sans-serif;
	}

	.receipt-button {
		margin-top: 4px;
		font-family: "IBM Plex Mono", monospace;
		font-size: 10.5px;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: #e6e8ea;
		background: transparent;
		border: 1px solid #2a2f37;
		padding: 12px;
		cursor: pointer;
		transition: border-color 160ms ease;
	}

	.receipt-button:hover {
		border-color: #4a4f57;
	}

	/* ============ animations ============ */
	@keyframes caretblink {
		0%, 49% { opacity: 1; }
		50%, 100% { opacity: 0; }
	}
	@keyframes gracepulse {
		0%, 100% { opacity: 0.55; }
		50% { opacity: 1; }
	}
	@keyframes vignettepulse {
		0%, 100% { opacity: 0.35; }
		50% { opacity: 0.7; }
	}
	@keyframes joinflick {
		0%, 100% { opacity: 0.85; }
		50% { opacity: 1; }
	}
	@keyframes joinslide {
		0% { left: -40%; }
		100% { left: 100%; }
	}
</style>
